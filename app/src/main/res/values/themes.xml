<resources>
    <style name="Theme.Zapret2UI" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/brand</item>
        <item name="colorSecondaryVariant">@color/brand_dark</item>
        <item name="colorOnSecondary">@color/white</item>

        <item name="android:windowBackground">@color/app_background</item>
        <item name="android:navigationBarColor">@color/app_background</item>
        <item name="android:statusBarColor">@color/app_background</item>
        <item name="android:fontFamily">sans</item>
        <item name="materialCardViewStyle">@style/Widget.Zapret.Card</item>
    </style>

    <style name="Widget.Zapret.Card" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">@color/app_surface</item>
        <item name="cardCornerRadius">24dp</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeColor">@color/app_outline</item>
        <item name="strokeWidth">1dp</item>
    </style>

    <style name="Widget.Zapret.PrimaryButton" parent="Widget.MaterialComponents.Button">
        <item name="android:minHeight">56dp</item>
        <item name="cornerRadius">18dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textSize">16sp</item>
        <item name="backgroundTint">@color/brand</item>
        <item name="iconTint">@color/white</item>
    </style>

    <style name="Widget.Zapret.SecondaryButton" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="android:minHeight">52dp</item>
        <item name="cornerRadius">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="strokeColor">@color/app_outline</item>
        <item name="android:textColor">@color/app_text_primary</item>
        <item name="iconTint">@color/app_text_primary</item>
    </style>
</resources>
